# ============================================
# 知行朋友圈 · 环境配置模板
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）
# ============================================

# ---- 数据库 ----
# PostgreSQL 连接串（必填）
SUDA_DATABASE_URL=postgres://用户名:密码@127.0.0.1:5432/zhixing

# ---- 服务监听 ----
SERVER_HOST=127.0.0.1
SERVER_PORT=3000
NODE_ENV=production

# ---- 平台认证域名 ----
# 使用飞书 aPaaS 全栈底座时必填；本地自托管可填一个不可达地址占位
FORCE_AUTHN_INNERAPI_DOMAIN=http://127.0.0.1:9

# ---- 日志 ----
LOG_DIR=./logs
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
